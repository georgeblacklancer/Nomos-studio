<?xml version="1.0" encoding="UTF-8"?>
<!--
  Concat's Windows Installer package, the .msi beside the Inno Setup .exe.

  Built by build-app.yml with WiX from the staged folder the .exe is made
  of, so the two installers ship the same files. The .exe is the
  one a person double-clicks; this is the one an administrator deploys -
  Group Policy, Intune, winget - and it installs for the machine, into
  Program Files, with a Start menu entry and a clean uninstall. Handed in:

    wix build -arch x64 -d Version=0.2.8 -d Root=C:\...\Concat
              -d Stage=C:\...\stage\NOMOS-Studio-0.2.8-windows-x86_64
              -o stage\NOMOS-Studio-0.2.8-windows-x86_64.msi assets\windows\concat.wxs

  Root is the repository: WiX resolves a source path against where it is
  run from, not against this file.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- One upgrade code for the life of the product, so a newer .msi
       replaces an older one rather than sitting beside it. -->
  <Package Name="NOMOS Studio"
           Manufacturer="Grupo NOMOS"
           Version="$(var.Version)"
           UpgradeCode="F3E00171-61A0-4B7F-B994-EA3E34E99710"
           Scope="perMachine"
           Language="1033">
    <MajorUpgrade DowngradeErrorMessage="Ya hay una versión más reciente de NOMOS Studio instalada." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="concat.ico" SourceFile="$(var.Root)\assets\icons\concat.ico" />
    <Property Id="ARPPRODUCTICON" Value="concat.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/georgeblacklancer/nomos-studio" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="NOMOS Studio" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="NOMOS Studio" />
    </StandardDirectory>

    <Feature Id="Main" Title="NOMOS Studio" Level="1">
      <ComponentGroupRef Id="Program" />
      <ComponentRef Id="StartMenu" />
    </Feature>

    <!-- Every file in the staged folder, as it is there. -->
    <ComponentGroup Id="Program" Directory="INSTALLFOLDER">
      <Files Include="$(var.Stage)\**" />
    </ComponentGroup>

    <Component Id="StartMenu" Directory="ShortcutFolder" Guid="261558A7-61E6-4559-9281-EF01D23C635F">
      <Shortcut Id="StartMenuShortcut"
                Name="NOMOS Studio"
                Description="Video editor"
                Target="[INSTALLFOLDER]concat.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="concat.ico" />
      <!-- The way in when a graphics driver draws the window as coloured
           squares: it turns off Settings > General > Draw on the GPU,
           which that window hides. -->
      <Shortcut Id="SafeGraphicsShortcut"
                Name="NOMOS Studio (gráficos seguros)"
                Description="NOMOS Studio, dibujado por software"
                Target="[INSTALLFOLDER]concat.exe"
                Arguments="--software"
                WorkingDirectory="INSTALLFOLDER"
                Icon="concat.ico" />
      <RemoveFolder Id="RemoveShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\NOMOS Studio" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Package>
</Wix>
